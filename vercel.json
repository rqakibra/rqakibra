{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/index",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/:folder(.*-Page)/:file(.*-index)",
      "destination": "/:folder",
      "permanent": true
    },
    {
      "source": "/:folder(.*-Page)/:file(.*-index.html)",
      "destination": "/:folder",
      "permanent": true
    }
  ]
}
